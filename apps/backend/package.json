{
  "name": "@c3-oss/vogal-backend",
  "description": "Vogal Backend",
  "version": "0.1.0",
  "author": "Caian Ertl <caian@c3.do>",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/vogal.git"
  },
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "node -r dotenv-expand/config --import @swc-node/register/esm-register src/index.ts",
    "bundle": "tsup",
    "typecheck": "tsc",
    "build": "concurrently pnpm:typecheck pnpm:bundle",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest --config test-unit.config.ts run",
    "test:coverage": "vitest --config test-unit.config.ts run --coverage",
    "test:e2e": "__USE_PGLITE=1 vitest --config test-e2e.config.ts run",
    "test:e2e:coverage": "__USE_PGLITE=1 vitest --config test-e2e.config.ts run --coverage",
    "check-all": "concurrently pnpm:typecheck pnpm:bundle pnpm:test:coverage pnpm:lint",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "npm run bump:dev && npm run bump:prod"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "^0.3.1",
    "@c3-oss/config-tsup": "^0.2.0",
    "@c3-oss/config-typescript": "^0.1.0",
    "@c3-oss/config-vitest": "^0.1.0",
    "@c3-oss/types": "^0.1.0",
    "@dbml/cli": "^3.14.1",
    "@faker-js/faker": "^10.1.0",
    "@types/lodash": "^4.17.20",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.15.5",
    "@types/restify-errors": "^4.3.9",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vite-tsconfig-paths": "5.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@c3-oss/drizzle-ulid": "^1.0.0",
    "@c3-oss/functional": "^1.0.0",
    "@c3-oss/logger": "^0.1.0",
    "@c3-oss/typeguard": "^0.2.0",
    "@electric-sql/pglite": "^0.3.10",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@google-cloud/storage": "^7.17.1",
    "@qdrant/js-client-rest": "^1.15.1",
    "@redis/json": "^1.0.7",
    "@t3-oss/env-core": "^0.13.8",
    "@trpc/server": "^11.7.0",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "fast-glob": "^3.3.3",
    "fastify": "^5.0.0",
    "firebase": "^12.4.0",
    "lodash": "^4.17.21",
    "openai": "^5.22.0",
    "opossum": "^9.0.0",
    "pdf-parse": "^2.3.0",
    "pg": "^8.16.3",
    "redis": "^5.8.3",
    "restify-errors": "^8.1.0",
    "safe-stable-stringify": "^2.5.0",
    "superjson": "^2.2.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  }
}
