Table documents.document_metadata as document_metadata {
  id serial [pk]
  document_id int [not null, ref: > documents.id]
  key varchar(100) [not null]
  value text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    ux_doc_meta [unique] (document_id, key)
  }
}

Ref: document_metadata.document_id > documents.id


