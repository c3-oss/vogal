Enum upload_status {
  queued
  processing
  completed
  failed
}

Table documents.document_uploads as document_uploads {
  id serial [pk]
  document_id int [not null, ref: > documents.id]
  status upload_status [not null]
  error_message text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Ref: document_uploads.document_id > documents.id


