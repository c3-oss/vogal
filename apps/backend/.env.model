LOG_LEVEL=debug

# ----------------------------------------------------------------------------------------------------------------------

# Postgres Database
DBIMG=postgres:14.18
DBHOST=rag_db
DBUSER=rag
DBPASS=rag
DBPORT=15432
DBNAME=rag

DATABASE_URL=postgres://${DBUSER}:${DBPASS}@localhost:${DBPORT}/${DBNAME}

# ----------------------------------------------------------------------------------------------------------------------

CACHEIMG=redis/redis-stack:7.2.0-v19
CACHEHOST=rag_cache
CACHEUSER=rag
CACHEPASS=rag
CACHEPORT=16379

REDIS_URL=redis://:${CACHEPASS}@localhost:${CACHEPORT}

# ----------------------------------------------------------------------------------------------------------------------

VECTORIMG=qdrant/qdrant:v1.15.5
VECTORHOST=rag_vector
VECTORPORT_HTTP=16333
VECTORPORT_GRPC=16334
VECTORTOKEN=

QDRANT_URL=http://localhost:${VECTORPORT_HTTP}
QDRANT_API_KEY=${VECTORTOKEN}

# ----------------------------------------------------------------------------------------------------------------------

LOCALSTACKIMG=localstack/localstack:4.9.2
LOCALSTACKHOST=rag_localstack

VOGAL_STORAGE_PROVIDER=s3
VOGAL_STORAGE_S3_BUCKET=rag
VOGAL_STORAGE_S3_ENDPOINT=http://localhost:4566
# VOGAL_STORAGE_S3_REGION=us-east-1
# VOGAL_STORAGE_S3_PUBLIC_BASE_URL=
# VOGAL_STORAGE_S3_FORCE_PATH_STYLE=

# ----------------------------------------------------------------------------------------------------------------------

OPENAI_API_KEY=
