{
  "name": "@c3-oss/vogal-frontend",
  "description": "Vogal frontend",
  "version": "0.1.0",
  "author": "Caian Ertl <caian@c3.do>",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/vogal.git"
  },
  "scripts": {
    "start": "vite dev",
    "bundle": "vite build",
    "typecheck": "tsc",
    "build": "concurrently pnpm:typecheck pnpm:bundle",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "npm run bump:dev && npm run bump:prod"
  },
  "devDependencies": {
    "@c3-oss/vogal-backend": "workspace:^",
    "@c3-oss/config-biome": "^0.3.1",
    "@tailwindcss/vite": "4.1.16",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "4.4.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "5.1.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-query": "^5.90.5",
    "@trpc/client": "^11.7.0",
    "@trpc/react-query": "^11.7.0",
    "@trpc/tanstack-react-query": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.9.4",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  }
}
