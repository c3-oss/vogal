{
  "name": "@c3-oss/vogal-frontend",
  "description": "Vogal frontend",
  "version": "0.1.0",
  "author": "Caian Ertl <caian@c3.do>",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/vogal.git"
  },
  "scripts": {
    "start": "vite dev",
    "bundle": "vite build",
    "typecheck": "tsc",
    "build": "concurrently pnpm:typecheck pnpm:bundle",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "npm run bump:dev && npm run bump:prod"
  },
  "devDependencies": {
    "@c3-oss/vogal-backend": "workspace:^",
    "@c3-oss/config-biome": "^0.3.1",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "8.0.13",
    "vite-tsconfig-paths": "6.1.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.100.10",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  }
}
