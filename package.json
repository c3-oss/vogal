{
  "name": "@c3-oss/vogal",
  "description": "Vogal",
  "version": "0.0.1",
  "author": "Caian Ertl <caian@c3.do>",
  "private": true,
  "main": "index.js",
  "license": "ISC",
  "homepage": "https://github.com/c3-oss/vogal#readme",
  "packageManager": "pnpm@11.1.2",
  "bugs": {
    "url": "https://github.com/c3-oss/vogal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/vogal.git"
  },
  "scripts": {
    "prepare": "husky",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:opt": "ncu --upgrade --dep optional --target minor",
    "bump:all": "pnpm run bump:opt && pnpm run bump:dev && pnpm run bump:prod"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@biomejs/biome": "^1.9.4",
    "@c3-oss/fim": "^0.1.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.2",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.62.4",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}
